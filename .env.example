# ---------------------------------------------------------------------------
# RespondeYA - variables de entorno
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.
# ---------------------------------------------------------------------------

# development | staging | production
VITE_ENV=development

# Driver de persistencia:
#   local    -> localStorage, funciona sin backend (demo / desarrollo offline)
#   http     -> API REST a traves del httpClient (Axios)
#   supabase -> Postgres + Storage en Supabase (contenido dinamico)
VITE_PERSISTENCE_DRIVER=local

# Solo se usa cuando VITE_PERSISTENCE_DRIVER=http
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Supabase - solo se usa cuando VITE_PERSISTENCE_DRIVER=supabase
# ---------------------------------------------------------------------------
# Panel de Supabase > tu proyecto > Settings > API Keys
# (o el boton "Connect" en la cabecera del proyecto, que muestra las dos).
#
# La URL tiene la forma https://<referencia-del-proyecto>.supabase.co
VITE_SUPABASE_URL=

# Clave PUBLICA. Vale tanto la nueva `sb_publishable_...` como la `anon` de
# siempre: `createClient` las recibe en el mismo parametro.
#
# AVISO: esta clave viaja en el bundle del navegador, asi que es publica de
# facto. Lo que impide que cualquiera escriba es la politica RLS de la base de
# datos, no el secreto de la clave.
#
# NUNCA pongas aqui la clave `sb_secret_...` ni la `service_role`: saltan RLS
# por diseno y acabarian publicadas en el JavaScript de la pagina.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
# debug | info | warn | error
VITE_LOG_LEVEL=debug
VITE_REQUEST_TIMEOUT_MS=30000
